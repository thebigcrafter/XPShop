{
    "name": "thebigcrafter/xpshop",
    "description": "A PocketMine-MP plugin for buying and selling XP",
    "type": "project",
    "license": "GPL-3.0-only",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/thebigcrafter/pmforms",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/thebigcrafter/Hydrogen",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/thebigcrafter/libMCUnicodeChars",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/thebigcrafter/libPiggyEconomy",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/axolotl-pm/PocketMine-MP",
            "no-api": true
        }
    ],
    "require": {
        "dktapps/pmforms": "^2.1.0",
        "thebigcrafter/hydrogen": "1.1.4",
        "tobydev27/libmcunicodechars": "2.0.1",
        "dapigguy/libpiggyeconomy": "3.0.4"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "axolotl-pm/pocketmine-mp": "5.49.1"
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse -c phpstan.neon.dist"
    }
}
